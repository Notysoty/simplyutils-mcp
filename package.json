{
  "name": "simplyutils-mcp",
  "version": "1.0.0",
  "description": "MCP server with everyday developer and text tools from SimplyUtils: JSON formatter, QR codes, unit converter, passwords, UUIDs, hashes, Base64, regex tester, timestamps and word counts.",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/http.js",
    "start:stdio": "node dist/stdio.js",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "chatgpt",
    "json",
    "qr-code",
    "unit-converter",
    "developer-tools"
  ],
  "author": "Memegician LLC (https://simplyutils.com)",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "bin": {
    "simplyutils-mcp": "dist/stdio.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "homepage": "https://simplyutils.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/Notysoty/simplyutils-mcp.git"
  },
  "engines": {
    "node": ">=20"
  }
}
